# ---------------------------------------------------------------
# Copy this file to .env and fill in your Worker URL.
#   cp .env.example .env
# ---------------------------------------------------------------

# Where the browser sends its measurement requests.
# Deploy the worker first (npm run deploy:worker), then paste the URL it prints.
VITE_SPEEDTEST_URL=https://speedtest-backend.<your-subdomain>.workers.dev

# Backend flavour. 'worker' is the Cloudflare Worker in ./worker.
# 'librespeed' expects LibreSpeed's empty.php / garbage.php / getIP.php instead —
# the client still supports it, but no PHP files ship with this project.
VITE_SPEEDTEST_BACKEND=worker

# Set this only if the built app is served from a subfolder, e.g. /speedtest/
# VITE_BASE=/speedtest/

# Optional: extra origins so parallel streams get separate TCP connections.
# Only useful on a backend that is far away AND speaks HTTP/2. Not needed on the
# Worker, where the edge is close enough that it makes no difference.
# VITE_SPEEDTEST_HOSTS=https://st1.example.net,https://st2.example.net
