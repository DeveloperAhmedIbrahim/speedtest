# Backend location used by the browser at runtime.
# Leave it as /server when the client is served from the same folder as the
# LibreSpeed php files (e.g. /var/www/html/speedtest/).
VITE_SPEEDTEST_URL=/server

# Dev-server only: where vite forwards /server/* during `npm run dev`.
SPEEDTEST_PROXY_TARGET=https://speedtest.techrevivals.net

# Set this if the built app lives in a subfolder, e.g. /speedtest/
# VITE_BASE=/speedtest/

# Optional: extra origins so parallel streams get their own TCP connections.
# Only needed when the backend is served over HTTP/2 (check the endpoint panel).
# All of these should point at the same server/ folder.
# VITE_SPEEDTEST_HOSTS=https://st1.techrevivals.net/server,https://st2.techrevivals.net/server,https://st3.techrevivals.net/server

# ---- Cloudflare Worker backend ----
# Deploy worker/ then switch these two lines. The Worker runs in every Cloudflare
# city, so every user is measured against their nearest edge.
# VITE_SPEEDTEST_BACKEND=worker
# VITE_SPEEDTEST_URL=https://speedtest-backend.<your-subdomain>.workers.dev
