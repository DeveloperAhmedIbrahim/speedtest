# Backend location used by the browser at runtime.
# Leave it as /server when the client is served from the same folder as the
# LibreSpeed php files (e.g. /var/www/html/speedtest/).
VITE_SPEEDTEST_URL=/server

# Dev-server only: where vite forwards /server/* during `npm run dev`.
SPEEDTEST_PROXY_TARGET=https://speedtest.techrevivals.net

# Set this if the built app lives in a subfolder, e.g. /speedtest/
# VITE_BASE=/speedtest/
